# Modelo do .env (copie para .env e preencha). O .env fica fora do Git e fora da imagem Docker.
# Ele serve ao Merlin no Windows (robô FIRMS Monitor) e ao docker compose (painel + observabilidade).

# ===== Robô FIRMS Monitor (NASA) =====
# Chave gratuita: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
FIRMS_SOURCE=VIIRS_NOAA20_NRT
# area -> usa FIRMS_BBOX (west,south,east,north) | country -> endpoint descontinuado pela NASA
FIRMS_QUERY_MODE=area
FIRMS_COUNTRY=BRA
# Brasil: -74.0,-34.0,-34.7,5.3
FIRMS_BBOX=-74.0,-34.0,-34.7,5.3
# Dias retroativos (1 a 5)
FIRMS_DAY_RANGE=1
FIRMS_TIMEOUT_SECONDS=60
FIRMS_MAX_RETRIES=3

# ===== Risco pelo FRP (MW) =====
RISK_MEDIO_FRP=10
RISK_ALTO_FRP=50
RISK_CRITICO_FRP=100
# Nível mínimo que dispara alerta: BAIXO | MEDIO | ALTO | CRITICO
ALERT_MIN_LEVEL=ALTO

# ===== Filtros =====
MIN_NUMERIC_CONFIDENCE=30
MIN_FRP=0

# ===== Arquivos do robô (Merlin no Windows; no contêiner o caminho é fixo) =====
OUTPUT_CSV=dados/incendio/ocorrencias.csv
CSV_DELIMITER=,
LOG_LEVEL=INFO

# ===== Mapa (opcional) =====
# Chave do MapTiler para os fundos Satélite/Escuro/Ruas. Vazia: OpenStreetMap.
MAPTILER_KEY=

# ===== Docker Compose: painel web de alertas =====
# operador (só vê) | administrador (também muda a busca automática pela tela)
PAINEL_PERFIL=operador
# Minutos entre as buscas automáticas: 0, 1, 15, 30, 60, 180, 360, 720 ou 1440 (0 desliga)
ALERTAS_INTERVALO=60
# 1: busca logo ao subir | 0: espera o intervalo
ALERTAS_BUSCAR_AO_INICIAR=1
# Porta do painel no computador (sempre em 127.0.0.1)
PAINEL_PORTA_HOST=8080

# ===== Docker Compose: observabilidade (portas sempre em 127.0.0.1) =====
PROMETHEUS_PORTA_HOST=9090
# 3001: a 3000 costuma estar com o Open WebUI
GRAFANA_PORTA_HOST=3001
GRAFANA_ADMIN_USER=admin
# Obrigatória: escolha uma senha forte (o compose não sobe sem ela)
GRAFANA_ADMIN_PASSWORD=
