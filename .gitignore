__pycache__/
*.pyc
.venv/
# Baixados por ferramentas/baixar_modelos.py (vários GB)
modelos/
# Gerados durante o uso: registros do raciocínio e amostras de vozes clonadas (dados pessoais)
registros/
vozes/clonadas/
# As automações da pessoa e o que cada uma mudou: têm caminhos de arquivos pessoais
automacoes/
# Assistente pessoal: fica só neste computador (usa uma voz clonada)
assistentes/rick.json
# Preferências de cada pessoa: têm caminhos de pastas pessoais
merlin_config.json
# Configuração do robô FIRMS Monitor e do docker compose: tem a chave da NASA e a senha do Grafana
.env
.env.*
!.env.example
# CSV e log que o robô grava
dados/
# Terraform: o estado guarda os segredos em texto puro (variáveis sensíveis entram nele), e os .tfvars
# têm as chaves. Nenhum vai para o Git. O .terraform.lock.hcl vai (fixa a versão do provider).
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
!*.tfvars.example
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
*.tfplan
tfplan
